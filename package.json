    "test": "pnpm -r test",
    "command-test": "node scripts/test-commands.mjs",
    "memory-eval": "node scripts/memory-eval.mjs",
    "agent-eval": "node scripts/agent-eval.mjs",
    "marifold": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@marifold/core": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
