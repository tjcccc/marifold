{
  "name": "@marifold/workspace",
  "version": "0.80.0",
  "private": true,
  "description": "Marifold local-first personal AI workspace",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check:versions": "node scripts/check-versions.mjs",
    "lint": "biome lint . && node scripts/markdown-wrap.mjs",
