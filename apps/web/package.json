{
  "name": "@marifold/web",
  "version": "0.62.0",
  "private": true,
  "type": "module",
  "description": "Marifold Web UI — browser client for the marifold service.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @marifold/core build && pnpm --filter @marifold/service build && pnpm build && playwright test"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@marifold/core": "workspace:*",
    "@marifold/service": "workspace:*",
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
