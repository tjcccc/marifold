{
  // Local development: `pnpm build`, then `npx wrangler dev`. The marifold CLI
  // deploys the same bundle with `marifold workspace bridge deploy cloudflare`.
  "name": "marifold-bridge",
  "main": "dist/cloudflare/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "BRIDGE", "class_name": "BridgeRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BridgeRelay"] }]
}
