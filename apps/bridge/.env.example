# Generate a random secret with at least 32 characters (openssl rand -hex 32).
# It registers hosts; joining a workspace uses a separate, single-use host invitation.
MARIFOLD_BRIDGE_REGISTRATION_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# SQLite database file. Keep it on persistent storage: host registrations and revocations live here.
MARIFOLD_BRIDGE_DATABASE=data/bridge.sqlite
