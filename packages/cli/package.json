{
  "name": "marifold",
  "version": "0.13.0",
  "description": "Marifold CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "marifold": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
