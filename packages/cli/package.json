{
  "name": "marifold",
  "version": "0.62.0",
  "description": "Marifold CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "marifold": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "cli": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@marifold/core": "workspace:*",
    "@marifold/service": "workspace:*",
    "@marifold/tui": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "license": "GPL-3.0-only"
}
